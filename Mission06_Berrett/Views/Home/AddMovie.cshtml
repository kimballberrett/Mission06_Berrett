@using Mission06_Berrett.Models
@model Movie

@{
    ViewData["Title"] = "Add a Movie";
}

<form method="post">
    @* Hidden field carries MovieId on edit submissions so EF knows which record to update *@
    @* On a new add, MovieId is 0 and EF inserts a new row instead *@
    <input type="hidden" asp-for="MovieId"/>

    <label>Title: </label>
    <input asp-for="Title"/>
    <span asp-validation-for="Title" class="text-danger"></span>
    <br/>
    <br/>

    @* Category dropdown populated from ViewBag.Categories (loaded in the controller) *@
    <label>Category: </label>
    <select asp-for="CategoryId">
        <option value="">-- Select a Category --</option>
        @foreach (Category c in ViewBag.Categories)
        {
            <option value="@c.CategoryId">@c.CategoryName</option>
        }
    </select>
    <span asp-validation-for="CategoryId" class="text-danger"></span>
    <br/>
    <br/>

    <label>Director: </label>
    <input asp-for="Director"/>
    <br/>
    <br/>

    <label>Year: </label>
    <input asp-for="Year"/>
    <span asp-validation-for="Year" class="text-danger"></span>
    <br/>
    <br/>

    <label>Rating: </label>
    <select asp-for="Rating">
        <option value="">-- Select a Rating --</option>
        <option value="G">G</option>
        <option value="PG">PG</option>
        <option value="PG-13">PG-13</option>
        <option value="R">R</option>
    </select>
    <br/>
    <br/>

    <label>Edited: </label>
    <select asp-for="Edited">
        <option value="false">No</option>
        <option value="true">Yes</option>
    </select>
    <br/>
    <br/>

    <label>Copied to Plex: </label>
    <select asp-for="CopiedToPlex">
        <option value="false">No</option>
        <option value="true">Yes</option>
    </select>
    <span asp-validation-for="CopiedToPlex" class="text-danger"></span>
    <br/>
    <br/>

    <label>Lent To: </label>
    <input asp-for="LentTo"/>
    <br/>
    <br/>

    <label>Notes: </label>
    <input asp-for="Notes"/>
    <span asp-validation-for="Notes" class="text-danger"></span>
    <br/>
    <br/>

    <button type="submit">Add Movie</button>
</form>

@* Loads jQuery validation so form errors appear client-side before the form is submitted *@
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
