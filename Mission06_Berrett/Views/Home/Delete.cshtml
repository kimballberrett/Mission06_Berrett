@model Mission06_Berrett.Models.Movie

@{
    ViewData["Title"] = "Confirm Delete";
}

<h2>Confirm Deletion</h2>
<h3>@Model.Title (@Model.Year)</h3>

<form method="post">
    <input type="hidden" asp-for="MovieId"/>

    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-info" asp-controller="Home" asp-action="MovieList">Cancel</a>
</form>
